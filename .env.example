# Nimiq user-friendly address that receives tips from the feed.
# Copy this file to .env and replace the placeholder with a real address.
VITE_MAKER_ADDRESS="NQ07 0000 0000 0000 0000 0000 0000 0000 0000"

# Supabase project (Project Settings -> API). The anon/publishable key is safe in the browser;
# the service role key is only ever used by Edge Functions and never goes in this file.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Set to "true" to keep the Daily Cup on local mock data instead of Supabase.
VITE_USE_MOCK="false"
